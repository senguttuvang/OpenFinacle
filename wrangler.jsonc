{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openfinacle",
  "account_id": "f7861b73f1ebb5f7d13f3329200fc639",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "openfinacle.plts.in", "custom_domain": true }],
  "assets": { "directory": "./out", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  "vars": { "APP_REVISION": "development", "DEMO_MODE": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "openfinacle-workflows", "database_id": "37fe4ba4-a2c3-48e3-9819-dd7620305bb4", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "openfinacle-documents" }],
  "containers": [{ "class_name": "BankingCore", "image": "./infrastructure/fineract/Dockerfile", "instance_type": "standard-2", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "CORE", "class_name": "BankingCore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BankingCore"] }]
}
