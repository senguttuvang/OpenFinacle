{
  "name": "openfinacle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3048",
    "dev:api": "wrangler dev --port 8788",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "static:oxlint": "oxlint src app tests",
    "static:knip": "knip",
    "static:depcruise": "depcruise --validate .dependency-cruiser.cjs src app",
    "static:type-coverage": "type-coverage --at-least 95 --ignore-catch",
    "static:all": "bun run static:oxlint && bun run static:eslint && bun run static:knip && bun run static:architecture && bun run static:depcruise && bun run static:cycles && bun run static:type-coverage && bun run static:duplicates",
    "check": "bun run typecheck && bun run lint && bun run static:all && bun test tests && bun run build && wrangler deploy --dry-run",
    "cli": "bun src/operations/cli/main.ts",
    "deploy": "bun run cli deploy",
    "static:eslint": "eslint --config config/quality/eslint.config.mjs src app",
    "static:architecture": "arch-contract check --no-baseline && arch-contract sync-agent-docs --check && bun test tests/architecture",
    "static:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src app",
    "static:duplicates": "jscpd src app --config config/quality/duplicates.json",
    "static:loc": "cloc src app --by-file --include-lang=TypeScript,JavaScript,CSS --timeout 0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@effect/cli": "^0.77.2",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "0.107.0",
    "@effect/schema": "^0.75.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@sentry/browser": "^11.8.0",
    "@sentry/cloudflare": "^11.8.0",
    "cmdk": "^1.1.1",
    "effect": "^3.19",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "arch-contract": "0.3.0",
    "cloc": "2.6.0-cloc",
    "dependency-cruiser": "^18.6.0",
    "eslint": "9",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-security": "4.0.0",
    "eslint-plugin-sonarjs": "4",
    "eslint-plugin-unicorn": "56.0.1",
    "jscpd": "4.0.9",
    "knip": "^6.41.0",
    "madge": "8.0.0",
    "oxlint": "^1.88.0",
    "postgres": "^3.4.9",
    "type-coverage": "^2.30.4",
    "typescript": "^6",
    "typescript-eslint": "8",
    "wrangler": "^4.151.0"
  }
}
