{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openfinacle-navigation-worker-fixture",
  "main": "../../src/runtime/http/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "enable_containers": false },
  "assets": {
    "directory": "../../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_REVISION": "navigation-local-fixture",
    "DEMO_MODE": "false"
  }
}
