{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openfinacle-finacle5-local-preview",
  "main": "src/planning-preview.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./out", "binding": "ASSETS", "run_worker_first": ["/api/*", "/"] },
  "vars": { "LOCAL_PLANNING_PREVIEW": "true", "APP_REVISION": "local-planning-preview" },
  "d1_databases": [{ "binding": "DB", "database_name": "finacle5-planning-local-only", "database_id": "00000000-0000-0000-0000-000000000005", "remote": false }]
}
